COMPOSE_PROJECT_NAME=temporal
ELASTICSEARCH_VERSION=7.17.27
POSTGRESQL_VERSION=16
POSTGRES_PASSWORD=temporal
POSTGRES_USER=temporal
POSTGRES_DEFAULT_PORT=5432

# Tag for the server image built from server/. The Temporal version that
# actually gets compiled is pinned in server/go.mod - keep the two in step.
# 1.32.0-160.1 is the floor: temporal.WithTokenProvider,
# global.authorization.remoteClusterAuth and global.tls.remoteClusters all
# need it.
TEMPORAL_VERSION=1.32.0-160.1

# The CLI only ever talks to the frontends as an ordinary client, so it does
# not need to match the server version.
TEMPORAL_ADMINTOOLS_VERSION=1.31.0
TEMPORAL_UI_VERSION=2.49.1
KEYCLOAK_VERSION=26.7.2

# Both secrets are filled in by ./scripts/setup-keycloak.sh.
#
# KEYCLOAK_CLIENT_SECRET     the `temporal-app` client: people, the CLI, SDK clients
# KEYCLOAK_REPLICATION_SECRET the `temporal-replication` client: what each
#                            cluster authenticates as when replicating to its peer
KEYCLOAK_CLIENT_SECRET=run-scripts-setup-keycloak.sh-to-fill-this-in
KEYCLOAK_REPLICATION_SECRET=run-scripts-setup-keycloak.sh-to-fill-this-in
